# Kopiér til /etc/desk.env og chmod 600. Læses af systemd.
DESK_PROVIDER=oanda
# OANDA practice-token (gratis demokonto). Botten laver KUN GET-kald til /candles.
OANDA_TOKEN=
# Alternativ: DESK_PROVIDER=twelvedata og TWELVEDATA_KEY=
TWELVEDATA_KEY=
# ntfy: vælg et langt, hemmeligt emnenavn – alle der kender det kan læse beskederne
NTFY_TOPIC=
# NTFY_URL=https://ntfy.sh
# DESK_DASHBOARD_HOST=0.0.0.0
# DESK_DASHBOARD_PORT=8787
