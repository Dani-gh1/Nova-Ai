# Papirdesk - KUN papirhandel med fiktive penge. Ingen API-nøgler.
# Installation: se README.md, afsnit "Drift som systemd-service".
[Unit]
Description=Papirdesk (papirhandel, perpetual futures, offentlige data)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=papirdesk
Group=papirdesk
WorkingDirectory=/opt/papirdesk
ExecStart=/usr/bin/python3 -m desk run
Restart=always
RestartSec=10
# Valgfrit: ntfy-emne og børs
Environment=PYTHONUNBUFFERED=1
#Environment=DESK_NTFY_TOPIC=mit-hemmelige-emne
#Environment=DESK_EXCHANGE=bybit
# Hærdning - botten skal kun kunne skrive i data/
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/papirdesk/data

[Install]
WantedBy=multi-user.target
